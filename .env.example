# ==============================================================================
# QuestForge Environment Configuration
# Copy this file to .env and configure your values.
# DO NOT commit .env to version control.
# ==============================================================================

# LLM Backend Selection: 'vertex_ai' or 'gemini_api'
LLM_BACKEND=gemini_api

# ------------------------------------------------------------------------------
# Option A: Gemini API (Developer key from Google AI Studio)
# Used when LLM_BACKEND=gemini_api
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-pro

# ------------------------------------------------------------------------------
# Option B: Google Cloud Vertex AI
# Used when LLM_BACKEND=vertex_ai
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=credentials/gcp-service-account.json
VERTEX_AI_MODEL=gemini-2.0-flash
VERTEX_AI_FALLBACK_MODEL=gemini-2.0-pro

# ------------------------------------------------------------------------------
# Pipeline & Prompt Configuration
# ------------------------------------------------------------------------------
PROMPTS_DIR=pipeline/prompts
LORE_STORE_PATH=chroma_db
CHECKPOINT_DB_PATH=.checkpoints/checkpoints.sqlite

# Critic Revision Policy
CRITIC_PASS_THRESHOLD=75
CRITIC_MAX_REVISIONS=3

# ------------------------------------------------------------------------------
# API Server Configuration
# ------------------------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DEBUG=true
