# ==============================================================================
# QuestForge Environment Configuration Template
# Copy this file to .env and configure your values.
# DO NOT commit .env to version control.
# ==============================================================================

# LLM Backend Selection: 'vertex_ai', 'gemini_api', 'openai', 'anthropic', or 'mock'
LLM_BACKEND=gemini_api

# ------------------------------------------------------------------------------
# Option A: Gemini API (Developer key from Google AI Studio)
# Used when LLM_BACKEND=gemini_api
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-pro

# ------------------------------------------------------------------------------
# Option B: Google Cloud Vertex AI
# Used when LLM_BACKEND=vertex_ai
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=credentials/gcp-service-account.json
VERTEX_AI_MODEL=gemini-2.5-flash
VERTEX_AI_FALLBACK_MODEL=gemini-2.5-pro

# ------------------------------------------------------------------------------
# Option C: OpenAI & OpenAI-Compatible / OpenAPI Endpoints
# Used when LLM_BACKEND=openai
# Works with official OpenAI, OpenRouter, Groq, DeepSeek, LocalAI, Ollama, vLLM
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# Option D: Anthropic (Claude)
# Used when LLM_BACKEND=anthropic
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
ANTHROPIC_FALLBACK_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ------------------------------------------------------------------------------
# Pipeline & Prompt Configuration
# ------------------------------------------------------------------------------
PROMPTS_DIR=pipeline/prompts
LORE_STORE_PATH=chroma_db
CHECKPOINT_DB_PATH=.checkpoints/checkpoints.sqlite

# Critic Revision Policy
CRITIC_PASS_THRESHOLD=75
CRITIC_MAX_REVISIONS=3

# ------------------------------------------------------------------------------
# API Server Configuration
# ------------------------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DEBUG=true
