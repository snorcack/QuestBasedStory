        "scenes": [
          {
            "scene_id": "sc_chapter_01_01",
            "title": "Arrival at loc_district_01",
            "location_id": "loc_district_01",
            "prose": "The acid precipitation hissed against the tarnished copper shutters of Elena's precinct cubicle. Her neural implant buzzed with a faint, phantom harmonic\u2014the remnant of an encryption handshake erased half a decade ago.",
            "characters_present": [
              "char_cross"
            ],
            "emotional_beat": "Isolation and persistent cerebral unease"
          },
          {
            "scene_id": "sc_chapter_01_02",
            "title": "Confrontation at loc_district_01_exit",
            "location_id": "loc_district_01_exit",
            "prose": "Underneath the damp arches of the conduit, steam billowed in rhythmic bursts. Elena drew her service sidearm, checking the battery charge with practiced thumb pressure. Every shadow in the Lower Conduit carried a price tag.",
            "characters_present": [
              "char_cross",
              "char_orin"
            ],
            "emotional_beat": "Rising vigilance and tactical tension"
          }
        ],
        "dialogue_tree": [
          {
            "node_id": "node_chapter_01_01",
            "type": "speaker",
            "speaker": "char_orin",
            "text": "The precinct drones are already circling the perimeter, Elena. What do you want to do with the courier's chip?",
            "choices": [
              {
                "label": "Hook it up to your deck. I need to bypass the security header right now.",
                "trait_tag": "Cunning",
                "flags_set": [
                  "chose_cunning_approach"
                ],
                "next_node": "node_chapter_01_02a",
                "condition_flag": null
              },
              {
                "label": "Tell me who delivered it, Orin. What happened to the courier?",
                "trait_tag": "Empathy",
                "flags_set": [
                  "chose_empathy_approach"
                ],
                "next_node": "node_chapter_01_02b",
                "condition_flag": null
              }
            ],
            "next_node": null
          },
          {
            "node_id": "node_chapter_01_02a",
            "type": "speaker",
            "speaker": "char_orin",
            "text": "Header cracked. The cipher points straight to the Spire Archives.",
            "choices": [],
            "next_node": "node_chapter_01_end"
          },
          {
            "node_id": "node_chapter_01_02b",
            "type": "speaker",
            "speaker": "char_orin",
            "text": "His name was Felix. They took him in the third sweep. But he left the access codes behind for us.",
            "choices": [],
            "next_node": "node_chapter_01_end"
          },
          {
            "node_id": "node_chapter_01_end",
            "type": "end",
            "speaker": "narrator",
            "text": "The rain outside redoubles as the terminal screen displays the decoded coordinates.",
            "choices": [],
            "next_node": null
          }
        ],
